    <style name="Theme.Nicestart.ActionBarWhite" parent="Theme.MaterialComponents.DayNight">
        <item name="actionBarStyle">@style/TransparentActionBar</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="Theme.Nicestart.ActionBarBlack" parent="Theme.MaterialComponents.DayNight">
        <item name="actionBarStyle">@style/TransparentActionBar</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>


    <style name="TransparentActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/morado</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Theme.Nicestart.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
